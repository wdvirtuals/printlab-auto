# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Bambu Lab X1C Printer Settings
X1C_IP=192.168.1.100
X1C_ACCESS_CODE=your_access_code_from_printer
X1C_SERIAL=your_printer_serial_number

# Optional: Allowed Telegram user IDs (comma-separated)
ALLOWED_USERS=

# Optional: REST API (for OpenClaw integration)
# Set API_PORT to enable the FastAPI server alongside the Telegram bot
API_PORT=8000
API_KEY=your_api_key_here
